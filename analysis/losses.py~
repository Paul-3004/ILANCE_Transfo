def create_loss_graphs(dir_path):
    losses = torch.load(dir_path + "/losses_epoch_9.pt")

    charges_train = losses["charges_train"]
    pdgs_train = losses["pdgs_train"]
    cont_train = losses["cont_train"]
    charges_val = losses["charges_val"]
    pdgs_val = losses["pdgs_val"]
    cont_val = losses["cont_val"]
    tot_train = losses["train"]
    tot_val = losses["val"]
    tokens_val = losses["tokens_val"]
    tokens_train = losses["tokens_train"]
    E_val = losses["cont_E_val"]
    E_train = losses["cont_E_train"]
    dir_val  = losses["cont_dir_val"]
    dir_train = losses["cont_dir_train"]
    epoch = np.arange(1,len(tot_train) + 1) 
    print(len(tot_train))
    print(tot_train)

    fig, ax = plt.subplots()
    ax.plot(epoch, tot_train, label = r"$\textrm{train}$", ls = "--", c = "lightcoral")
    ax.plot(epoch, tot_val, label = r"$\textrm{val}$", c = "darkred")
    ax.set(xlabel = r"$\textrm{epoch}$", ylabel = r"$\textrm{loss}$")
    ax.legend()
    ax.grid(which = "both")
    fig.savefig("train_val_single.svg", format ="svg", transparent = True)
    

    fig2, ax2 = plt.subplots()
    ax2.plot(epoch, pdgs_train, label = r"$\textrm{PDG}$", ls = "--", c = "lightcoral")
    ax2.plot(epoch, charges_train, label =r"$\textrm{charges}$", ls = "-.", c = "firebrick")
    ax2.plot(epoch, cont_train, label = r"$\textrm{cont.}$", c = "darkred")
    ax2.plot(epoch, tokens_train, label = r"$\textrm{tokens}$", c = "blue")
    ax2.set(xlabel = r"$\textrm{epoch}$", ylabel = r"$\textrm{validation loss}$")
    ax2.legend()
    ax2.grid(which = "both")
    fig2.savefig("train_all_losses.svg", format = "svg", transparent = True)
    fig3, ax3 = plt.subplots()
    ax3.plot(epoch, E_train, label = r"$E$", c = "lightcoral")
    ax3.plot(epoch, dir_train, label = r"$\theta$", c = "firebrick")
    ax3.legend()
    ax3.grid(which = "both")
    ax3.set(xlabel = r"$\textrm{epoch}$", ylabel = r"$\textrm{training loss cont.}$")
    fig3.savefig("train_cont_split.svg", format = "svg", transparent = True)
    fig4,ax4 = plt.subplots()
    ax4.plot(epoch, E_val, label = r"$E$", c = "lightcoral")
    ax4.plot(epoch, dir_val, label = r"$\theta$", c = "firebrick")
    ax4.legend()
    ax4.grid(which = "both")
    ax4.set(xlabel = r"$\textrm{epoch}$", ylabel = r"$\textrm{validation loss cont.}$")
    fig4.savefig("val_cont_split.svg", format = "svg", transparent = True)
def compare_losses_runs(dir_paths: list, labels, savefig):

    fig_train, ax_train = plt.subplots()
    fig_val, ax_val = plt.subplots()
    #colour = [[0.57647  ,0.00000  ,0.00784], [0.04314  ,0.46275  ,0.62745], "red"]
    #colour = None
    diff_loss = []
    nfiles = [640,64,64]
    for i, dir_path in enumerate(dir_paths):
        losses = torch.load(dir_path + "/losses_epoch_29.pt")
        loss_tot_train = losses["train"]
        epoch = np.arange(1, len(loss_tot_train)+1) 
        diff_loss.append((loss_tot_train[-1] - loss_tot_train[1] )/ 99)
        
        #ax_train.plot(epoch, loss_tot_train, label = labels[i], color = colour[i])
        ax_train.plot(epoch, loss_tot_train, label = labels[i])
        ax_train.set(xlabel = r"$\textrm{epochs}$", ylabel = r"$\textrm{training loss}$")
        ax_train.grid(which = "both")
        ax_train.legend()

        loss_tot_val = losses["val"]
        ax_val.plot(epoch, loss_tot_val, label =labels[i])
        ax_val.set(xlabel = r"$\textrm{epochs}$", ylabel = r"$\textrm{validation loss}$")
        ax_val.grid(which = "both")
        ax_val.legend(loc = "upper right")
    if savefig:
        fig_train.savefig("compare_train_loss.svg", format = "svg", transparent = True)
        fig_val.savefig("compare_val_loss.svg", format = "svg", transparent = True)    


if __name__ == "__main__":
    parser = ArgumentParser()
    parser.add_argument("-dir", type = str, help = "Directory of the files")
    parser.add_argument("-dirs", type = str, nargs = '+', help = "Directory of the files")
    parser.add_argument("--compare", action= "store_true")

    args = parser.parse_args()
    savefig = True
    if args.compare:
        if len(args.dirs) > 0:
            #labels =  [r"$\textrm{schedule}$",r"$\textrm{no schedule}$",r"$32$", r"$64$", r"$128$", r"$\textrm{V2 4 epochs}$"]
            labels =  [r"$8$",r"$16$",r"$32$", r"$64$", r"$128$", r"$\textrm{V2 4 epochs}$"] 
            compare_losses_runs(args.dirs, labels, savefig)
            print("finished")
            plt.show()
        else:
            raise ValueError("Empty list for comparison")
    else:
        if args.dir is not None:
            create_loss_graphs(args.dir)
            plt.show()
        elif len(args.dirs) > 0:
            for _dir in args.dirs:
                create_loss_graphs(_dir)
            plt.show()
        else:
            raise ValueError("No directory was given")

